# Copiá este archivo a .env y completá los valores. .env NUNCA se commitea (ver .gitignore).

# --- Base de datos (obligatorio) ---
# Postgres. Podés usar un proveedor gratuito como Neon (neon.tech), Railway o Supabase Postgres.
DATABASE_URL="postgresql://usuario:password@host:5432/numen?sslmode=require"

# --- Sesiones (obligatorio) ---
# Generalo con: openssl rand -base64 32
AUTH_SECRET=""

# --- Login con Google (opcional) ---
# Si dejás estas dos vacías, el botón de Google no aparece.
# Creás las credenciales en https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://TU_DOMINIO/api/auth/callback/google (y http://localhost:3000/api/auth/callback/google en dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Login por magic link / email (opcional) ---
# Si dejás estas dos vacías, la opción de "link mágico" no aparece.
# EMAIL_SERVER es una connection string SMTP, ej: smtp://usuario:password@smtp.resend.com:587
EMAIL_SERVER=""
EMAIL_FROM="Numen <noreply@tudominio.com>"
